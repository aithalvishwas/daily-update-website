# Public entry point for WorkPulseLens in production.
# Caddy gets and renews free HTTPS certificates (Let's Encrypt) on its own.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy frontend:8080
}

# www.workpulselens.com -> workpulselens.com
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
