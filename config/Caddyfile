# Public entry point for WorkPulseLens in production.
# Caddy gets and renews free HTTPS certificates (Let's Encrypt) on its own.
{
	# Company workspaces (google.workpulselens.com) get their certificate the first time someone
	# opens them. Caddy first asks the app whether that workspace exists, so nobody can make it
	# request certificates for made-up names.
	on_demand_tls {
		ask http://auth-service:4001/api/companies/tls-check
	}
}

(app) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy frontend:8080
}

# workpulselens.com: the public site, where companies sign up.
{$DOMAIN} {
	import app
}

# www.workpulselens.com -> workpulselens.com
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# <company>.workpulselens.com: each company's workspace. Needs a wildcard DNS record (* -> server IP).
*.{$DOMAIN} {
	tls {
		on_demand
	}
	import app
}
