# Copy this file to config/.env and fill in the values. Never commit .env.

# Port the website is served on (http://localhost:8080)
APP_PORT=8080

# Database
POSTGRES_USER=dailyupdate
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=dailyupdate

# Secret used to sign login tokens. At least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Workspace that holds the admin and manager below (and everything from before company
# workspaces existed). It's served at app.workpulselens.com (app.localhost:8080 on your computer).
DEFAULT_WORKSPACE=app

# First admin account: adds, edits and deactivates every account (managers to interns).
# Created on first start if no admin exists yet. Admins give other accounts their role
# (employee, manager or admin) on the Accounts page.
ADMIN_NAME=Vishwas
ADMIN_EMAIL=vishwas@workpulselens.com
ADMIN_PASSWORD=change-me-please

# First manager account, created on first start if no manager exists yet.
MANAGER_NAME=Manager
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=change-me-please

# Invite emails ("set your password" links). Sign up at https://resend.com, verify your domain
# there, and paste the API key. Without a key, admins copy the link from the Accounts page.
RESEND_API_KEY=
MAIL_FROM=WorkPulseLens <noreply@workpulselens.com>

# AI summaries. Without a key the app still works and shows a basic (non-AI) summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Production only (config/deploy.sh): the domain WorkPulseLens is served on over HTTPS.
DOMAIN=workpulselens.com
